{
  "name": "dsh-semantic-docs",
  "version": "0.1.0",
  "description": "语义文档系统插件：把「每个能力都有一份说清自身语义的文档」做成可执行、可检查的设施——注册表读写 + 状态重判 + D1–D6 drift 检查 + 索引生成。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/",
    "test:file": "node --test tests/markdown.test.mjs tests/status.test.mjs tests/drift.test.mjs tests/registry.test.mjs tests/corpse.test.mjs"
  }
}
